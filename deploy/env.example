# Settings for the nightly alerts job. Copy to .env in the project folder, fill it in, then
#   sudo chown insider:insider .env && sudo chmod 600 .env
# Read by deploy/run.sh with sh: plain KEY="value" lines, no spaces around the =.
# Never commit this file (.gitignore already excludes it).

# Required by the SEC on every request: YOUR name and email. It is not a key and needs no
# sign-up; the SEC uses it to contact (or block) whoever runs a misbehaving tool.
SEC_USER_AGENT="Your Name you@example.com"

# Where alerts are posted. Discord: channel settings > Integrations > Webhooks > New Webhook >
# Copy Webhook URL. Treat it like a password: anyone holding it can post to the channel.
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE/ME"

# Optional: a private channel for "the nightly run broke" messages. Without it they go to the
# alerts channel above.
# DISCORD_ADMIN_WEBHOOK_URL="https://discord.com/api/webhooks/REPLACE/ME"

# Optional: a rules file somewhere other than alerts.toml in the project folder.
# INSIDER_ALERTS="/opt/insider-tracker/alerts.toml"
